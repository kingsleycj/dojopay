# Copy to .env.local.
# Everything here is NEXT_PUBLIC_ and therefore visible in the browser bundle —
# never put a secret in this file.

NEXT_PUBLIC_BACKEND_URL=http://localhost:3000

# devnet | testnet | mainnet-beta. This is the single source of truth for which
# cluster the app talks to.
NEXT_PUBLIC_SOLANA_NETWORK=devnet

# Optional custom RPC. Falls back to the public cluster endpoint.
NEXT_PUBLIC_RPC_URL=

# Must match the backend's PLATFORM_WALLET_ADDRESS, or funding transactions will
# be rejected as sent to the wrong recipient.
NEXT_PUBLIC_PLATFORM_WALLET_ADDRESS=

NEXT_PUBLIC_CLOUDFRONT_URL=https://your-distribution.cloudfront.net/

// DojoPay data model. See CLAUDE.md §3.
//
// Money is stored as BigInt lamports. Never store SOL as a float — 9 decimal
// places do not survive IEEE-754.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity
// ---------------------------------------------------------------------------

enum AccountStatus {
  ACTIVE
  /// Temporarily blocked by an admin. Can log in to see the reason, cannot act.
  SUSPENDED
  /// Permanently blocked. Cannot log in.
  BANNED
}

enum AuthProvider {
  EMAIL
  GOOGLE
  WALLET
}

/// Which surface an account prefers. Not a role — one person can do both, and
/// switching is a view change rather than a second sign-in.
enum AccountMode {
  CREATOR
  WORKER
}

/// One human, one row.
///
/// Credentials live here, not on the role profiles, so a person who both posts
/// and completes tasks has a single login and a single audit trail. `User` and
/// `Worker` become *profiles* hanging off an account rather than independent
/// identities keyed by wallet address.
model Account {
  id Int @id @default(autoincrement())

  /// Null for wallet-first signups until they link an email in settings.
  email         String? @unique
  emailVerified Boolean @default(false)
  /// Argon2id hash. Null for Google-only or wallet-only accounts.
  passwordHash  String?
  googleId      String? @unique

  displayName String?
  avatarUrl   String?

  /// Proven by an ed25519 signature, never simply asserted. Null until linked —
  /// and a worker cannot withdraw without it.
  walletAddress  String?   @unique
  walletLinkedAt DateTime?

  /// How this account first signed up. Kept for funnel analysis; an account can
  /// accumulate more methods over time.
  signupProvider AuthProvider @default(EMAIL)

  status          AccountStatus @default(ACTIVE)
  statusReason    String?
  statusChangedAt DateTime?

  /// Wallet address of whoever's share link brought them in.
  referredBy String?

  /// Set once, the first time a welcome email is actually sent. Wallet-first
  /// accounts have no address to send to, so this stays null until they link
  /// and verify one — which is also what makes the send idempotent.
  welcomeEmailSentAt DateTime?

  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // -- Preferences -----------------------------------------------------------

  /// Which surface to land on after signing in. A person can be both, so this
  /// is a preference rather than a role.
  defaultMode AccountMode @default(WORKER)

  /// Transactional-but-optional email. Security mail (verification, password
  /// reset, suspension) is deliberately not switchable — it is not marketing,
  /// and losing it means losing access to the account.
  notifyTaskActivity Boolean @default(true)
  notifyPayouts      Boolean @default(true)
  notifyProductNews  Boolean @default(false)

  /// Role profiles. Created on demand the first time the account acts in that
  /// role, so signing up does not force a choice.
  creatorProfile User?
  workerProfile  Worker?

  /// Per-account balance of platform-held SOL. Created lazily like the profiles.
  vault Vault?

  tokens    VerificationToken[]
  auditLogs AuditLog[]

  @@index([status])
  @@index([createdAt])
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

/// Short-lived single-use tokens for email flows.
///
/// Only the hash is stored: a leaked database dump must not let anyone reset a
/// password or verify an address they do not control.
model VerificationToken {
  id         Int       @id @default(autoincrement())
  account_id Int
  account    Account   @relation(fields: [account_id], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  type       TokenType
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime  @default(now())

  @@index([account_id, type])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Role profiles
// ---------------------------------------------------------------------------

/// Creator profile: someone who funds tasks.
model User {
  id         Int     @id @default(autoincrement())
  account_id Int     @unique
  account    Account @relation(fields: [account_id], references: [id], onDelete: Cascade)

  tasks     Task[]
  payouts   Payouts[]
  createdAt DateTime  @default(now())
}

/// Worker profile: someone who completes tasks.
model Worker {
  id         Int     @id @default(autoincrement())
  account_id Int     @unique
  account    Account @relation(fields: [account_id], references: [id], onDelete: Cascade)

  /// Earned but not yet withdrawn, in lamports.
  pending_amount BigInt @default(0)

  /// Cumulative lamports already paid out. Previously named `locked_amount`,
  /// which implied an escrow lock it never performed.
  withdrawn_amount BigInt @default(0)

  submissions Submission[]
  payouts     Payouts[]
  createdAt   DateTime     @default(now())
}

// ---------------------------------------------------------------------------
// Vaults
// ---------------------------------------------------------------------------

/// A creator's balance of platform-held SOL.
///
/// Money arrives in one place — the platform wallet — but it is never pooled
/// conceptually: every lamport in it belongs to exactly one account, and this
/// row is the record of whose. A creator tops the vault up once, then funds any
/// number of tasks from it without another wallet round-trip.
///
/// `available + reserved` is what the account owns. `reserved` is committed to
/// open tasks and can be neither spent elsewhere nor withdrawn; it converts to
/// worker earnings as submissions land, or returns to `available` when a task
/// ends with slots unfilled.
model Vault {
  id         Int     @id @default(autoincrement())
  account_id Int     @unique
  account    Account @relation(fields: [account_id], references: [id], onDelete: Cascade)

  /// Unreserved lamports: spendable on a new task, or withdrawable.
  available BigInt @default(0)
  /// Lamports committed to tasks that are still accepting submissions.
  reserved  BigInt @default(0)

  /// Lifetime totals, for the statement header. Derived from `entries`, stored
  /// so the common read does not have to aggregate the whole ledger.
  totalDeposited BigInt @default(0)
  totalWithdrawn BigInt @default(0)
  totalSpent     BigInt @default(0)

  entries VaultEntry[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum VaultEntryType {
  /// SOL moved from the creator's wallet into the platform wallet.
  DEPOSIT
  /// SOL moved back out to the creator's wallet.
  WITHDRAWAL
  /// available → reserved, when a task is funded.
  TASK_FUNDED
  /// reserved → available, when a task ends with slots unfilled.
  TASK_REFUND
  /// reserved → spent, when a worker's submission is accepted.
  REWARD_RELEASED
}

enum VaultEntryStatus {
  /// On-chain leg submitted, not yet confirmed. Only DEPOSIT/WITHDRAWAL use it.
  PENDING
  SUCCESS
  FAILED
}

/// Append-only ledger behind a `Vault`.
///
/// Every balance change writes one row, carrying the balances it produced. That
/// makes a statement reconstructible and a discrepancy locatable — the previous
/// design could only ever show the current number.
model VaultEntry {
  id       Int   @id @default(autoincrement())
  vault_id Int
  vault    Vault @relation(fields: [vault_id], references: [id], onDelete: Cascade)

  type   VaultEntryType
  status VaultEntryStatus @default(SUCCESS)

  /// Always positive. Direction is carried by `type`, so a sign convention
  /// cannot be misread at a call site.
  amount BigInt

  /// Balances immediately after this entry was applied.
  availableAfter BigInt
  reservedAfter  BigInt

  /// On-chain signature for DEPOSIT and WITHDRAWAL. UNIQUE is load-bearing in
  /// exactly the way `Task.signature` was: it makes a replayed deposit — or a
  /// retried withdrawal — impossible to double-count.
  signature String? @unique

  task_id Int?
  task    Task? @relation(fields: [task_id], references: [id], onDelete: SetNull)

  /// Human-readable line for the statement, e.g. the task title.
  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([vault_id, createdAt])
  @@index([type, createdAt])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Tasks
// ---------------------------------------------------------------------------

enum TaskStatus {
  /// Accepting submissions.
  OPEN
  /// Reached `maxSubmissions`; fully subscribed.
  COMPLETED
  /// Passed expiresAt with capacity to spare.
  EXPIRED
  /// Closed early by the creator. Any unfilled slots were released back to
  /// their vault — as they also are on EXPIRED and FORCE_CLOSED, so this status
  /// records *who ended it*, while `refundedAmount` records what came back.
  REFUNDED
  /// Closed by an admin for abuse. Terminal; distinct from COMPLETED so the
  /// difference is visible in reporting.
  FORCE_CLOSED
}

model Task {
  id      Int    @id @default(autoincrement())
  title   String @default("Select your preferred choice")
  user_id Int
  user    User   @relation(fields: [user_id], references: [id])

  /// Funding transaction signature, for tasks paid for by a direct transfer.
  ///
  /// Nullable since vaults: a vault-funded task has no transaction of its own —
  /// the signature lives on the `DEPOSIT` entry that put the SOL there. UNIQUE
  /// still holds for the rows that have one (Postgres permits many NULLs), so
  /// the anti-replay guarantee is unchanged for legacy tasks.
  signature String? @unique

  /// Total lamports committed to this task.
  amount BigInt

  /// Lamports a worker earns per accepted submission.
  ///
  /// Stored rather than derived. It used to be `amount / MAX_SUBMISSIONS`, a
  /// global constant, so changing that constant would silently have rewritten
  /// the reward on every task ever created — including ones already paid out.
  rewardPerSubmission BigInt

  /// How many submissions this task accepts. Chosen per task by the creator;
  /// `amount` is reserved to cover exactly this many rewards.
  maxSubmissions Int @default(100)

  /// True when funding came from the creator's vault. Tasks created before
  /// vaults existed are false and have no reservation to release or refund.
  vaultFunded Boolean @default(false)

  /// Lamports returned to the creator's vault for slots that were never filled.
  refundedAmount BigInt @default(0)

  /// Retained for backwards compatibility with existing reads; derived from
  /// `status`. Prefer `status` in new code.
  done Boolean @default(false)

  status TaskStatus @default(OPEN)

  /// Denormalised count so the submission cap can be enforced without a
  /// COUNT(*) on every worker request. Kept in step inside a transaction.
  submissionCount Int @default(0)

  /// Set once the on-chain escrow program owns this task's funds (Phase 6).
  /// Null means the task is funded through the legacy custodial wallet.
  vaultAddress String?

  /// Populated when an admin force-closes the task.
  moderationReason String?

  options      Option[]
  submissions  Submission[]
  vaultEntries VaultEntry[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  expiresAt DateTime?

  @@index([status, expiresAt])
  @@index([user_id])
  @@index([createdAt])
}

model Option {
  id          Int          @id @default(autoincrement())
  image_url   String
  task_id     Int
  task        Task         @relation(fields: [task_id], references: [id], onDelete: Cascade)
  submissions Submission[]

  @@index([task_id])
}

model Submission {
  id        Int    @id @default(autoincrement())
  worker_id Int
  worker    Worker @relation(fields: [worker_id], references: [id])
  option_id Int
  option    Option @relation(fields: [option_id], references: [id])
  task_id   Int
  task      Task   @relation(fields: [task_id], references: [id], onDelete: Cascade)

  /// Lamports credited to the worker for this submission.
  amount BigInt

  createdAt DateTime @default(now())

  /// One answer per worker per task.
  @@unique([worker_id, task_id])
  @@index([worker_id])
  @@index([task_id])
  @@index([createdAt])
}

enum PayoutStatus {
  /// Transaction submitted, not yet confirmed.
  PROCESSING
  /// Confirmed on chain.
  SUCCESS
  /// Failed; the worker's pending balance was restored.
  FAILED
}

model Payouts {
  id        Int     @id @default(autoincrement())
  user_id   Int?
  user      User?   @relation(fields: [user_id], references: [id])
  worker_id Int?
  worker    Worker? @relation(fields: [worker_id], references: [id])

  amount BigInt

  /// On-chain transaction signature. UNIQUE gives payout idempotency: a retried
  /// request cannot record — or pay — the same withdrawal twice.
  signature String @unique

  status PayoutStatus @default(PROCESSING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([worker_id])
  @@index([status])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Admin
// ---------------------------------------------------------------------------

enum AdminRole {
  /// Full access including managing other admins.
  OWNER
  /// Read plus moderation actions.
  ADMIN
  /// Read-only. For anyone who needs numbers but not power.
  ANALYST
}

/// Staff accounts. Deliberately a separate table from `Account` with its own
/// JWT secret and its own route prefix, so no user token can ever satisfy an
/// admin check. There is no admin signup route — the first OWNER is created by
/// `npm run admin:create`, which runs against the database directly.
model AdminUser {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String
  displayName  String
  role         AdminRole @default(ANALYST)

  /// Base32 TOTP secret. Required before the account can do anything: login
  /// returns a setup challenge until 2FA is enrolled.
  totpSecret  String?
  totpEnabled Boolean @default(false)

  isActive    Boolean   @default(true)
  lastLoginAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  auditLogs AuditLog[]
}

// ---------------------------------------------------------------------------
// Audit
// ---------------------------------------------------------------------------

enum ActorType {
  ACCOUNT
  ADMIN
  /// Background jobs: expiry sweeps, payout confirmations.
  SYSTEM
}

enum AuditSeverity {
  INFO
  NOTICE
  WARNING
  CRITICAL
}

/// Append-only record of everything that happens.
///
/// Never updated or deleted by application code — an audit log you can edit is
/// not an audit log. Retention is handled out-of-band.
model AuditLog {
  id Int @id @default(autoincrement())

  actorType      ActorType
  actorAccountId Int?
  actorAccount   Account?   @relation(fields: [actorAccountId], references: [id], onDelete: SetNull)
  actorAdminId   Int?
  actorAdmin     AdminUser? @relation(fields: [actorAdminId], references: [id], onDelete: SetNull)

  /// Stable machine-readable verb, e.g. ACCOUNT_LOGIN, PAYOUT_SUCCEEDED.
  action   String
  severity AuditSeverity @default(INFO)

  /// What the action was performed on, e.g. "task" / 42.
  entityType String?
  entityId   String?

  /// Action-specific detail. Must never contain secrets, tokens, or password
  /// hashes — this table is read by every admin.
  metadata Json?

  ipAddress String?
  userAgent String?

  createdAt DateTime @default(now())

  @@index([actorAccountId, createdAt])
  @@index([actorAdminId, createdAt])
  @@index([action, createdAt])
  @@index([entityType, entityId])
  @@index([severity, createdAt])
  @@index([createdAt])
}

node_modules
# Keep environment variables out of version control
.env

/src/generated/prisma

/prisma/dev.db
# Backups of .env made by tooling — these contain the same secrets.
.env.backup-*
.env.*.backup

# Compiled output. Render builds this on deploy; committing it means every PR
# carries a second, stale copy of the whole backend.
/dist

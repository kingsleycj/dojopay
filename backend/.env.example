# Copy to .env and fill in. The server refuses to start if any required value is
# missing — there are no fallback secrets.

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/dojopay

# --- Auth ---
# One session per person; roles are resolved from profiles, not the token.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Signs ADMIN sessions. MUST be independently generated and different from
# JWT_SECRET — a shared secret would let any user token be replayed against the
# admin API, which can read every account's data.
ADMIN_JWT_SECRET=

# --- Email (Resend) ---
# Without a key, verification and password-reset links are written to the server
# log instead of being sent. That is fine locally; the server refuses to boot in
# production without it, because otherwise nobody can verify an address or
# recover an account.
RESEND_API_KEY=
MAIL_FROM="DojoPay <onboarding@resend.dev>"

# --- Google sign-in (optional) ---
# Leave blank to disable; the frontend hides the Google button automatically.
# The callback must match the redirect URI registered in the Google console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/v1/auth/google/callback

# --- Solana ---
RPC_URL=https://api.devnet.solana.com
SOLANA_CLUSTER=devnet
# Wallet that receives task funding and settles worker payouts.
PLATFORM_WALLET_ADDRESS=
# base58 secret key for PLATFORM_WALLET_ADDRESS. This key controls every open
# task's funds — keep it out of source control and rotate it if exposed.
PRIVATE_KEY=

# --- Storage (Cloudflare R2) ---
#
# R2 speaks the S3 API, so the AWS SDK is still the client — but three things
# differ and each fails in a way that is hard to read from the error. See
# backend/src/lib/storage.ts.
#
# Where to find each value in the Cloudflare dashboard:
#
#   R2_ACCOUNT_ID       R2 → Overview. The 32-character hex string, also visible
#                       in the "S3 API" endpoint Cloudflare shows you. The
#                       endpoint is built from this, so do not paste the full URL
#                       here — just the id.
#   R2_BUCKET_NAME      R2 → your bucket's name.
#   R2_ACCESS_KEY_ID    R2 → Manage API Tokens → Create API Token.
#   R2_SECRET_ACCESS_KEY  Shown once, at token creation. Copy it then.
#   R2_PUBLIC_URL       R2 → your bucket → Settings → Public access. Either the
#                       r2.dev subdomain or a custom domain you connect. Buckets
#                       are PRIVATE by default: without this, uploads succeed and
#                       every task image 404s for workers.
#
# Token permissions: "Object Read & Write", scoped to this bucket only. An
# account-wide admin token in a .env file is a much larger blast radius than
# this application needs.
R2_ACCOUNT_ID=
R2_BUCKET_NAME=dojopay
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Trailing slash optional — it is normalised either way.
R2_PUBLIC_URL=https://pub-<hash>.r2.dev/

# Optional. Only set this if you need to override the endpoint derived from
# R2_ACCOUNT_ID, e.g. for a jurisdiction-restricted bucket:
#   https://<account-id>.eu.r2.cloudflarestorage.com
# R2_ENDPOINT=

# Region is NOT configurable: R2 requires the literal "auto", and a real AWS
# region name is accepted by the SDK and then rejected at signing time. The old
# S3_BUCKET_REGION variable no longer does anything.
#
# The previous AWS names (S3_BUCKET_NAME, S3_BUCKET_ACCESS_KEY_ID,
# S3_BUCKET_SECRET_ACCESS_KEY, CLOUDFRONT_URL) are still read as fallbacks so a
# deploy does not break between shipping this code and updating the environment.
# Delete them once R2 is configured everywhere.

# --- App ---
PORT=3000
NODE_ENV=development
# Also used as the base URL for links in emails.
FRONTEND_URL=http://localhost:5174

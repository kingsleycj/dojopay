# Copy to .env and fill in. The server refuses to start if any required value is
# missing — there are no fallback secrets.

# --- Database ---
DATABASE_URL=postgresql://user:password@localhost:5432/dojopay

# --- Auth ---
# One session per person; roles are resolved from profiles, not the token.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Signs ADMIN sessions. MUST be independently generated and different from
# JWT_SECRET — a shared secret would let any user token be replayed against the
# admin API, which can read every account's data.
ADMIN_JWT_SECRET=

# --- Email (Resend) ---
# Without a key, verification and password-reset links are written to the server
# log instead of being sent. That is fine locally; the server refuses to boot in
# production without it, because otherwise nobody can verify an address or
# recover an account.
RESEND_API_KEY=
MAIL_FROM="DojoPay <onboarding@resend.dev>"

# --- Google sign-in (optional) ---
# Leave blank to disable; the frontend hides the Google button automatically.
# The callback must match the redirect URI registered in the Google console.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/v1/auth/google/callback

# --- Solana ---
RPC_URL=https://api.devnet.solana.com
SOLANA_CLUSTER=devnet
# Wallet that receives task funding and settles worker payouts.
PLATFORM_WALLET_ADDRESS=
# base58 secret key for PLATFORM_WALLET_ADDRESS. This key controls every open
# task's funds — keep it out of source control and rotate it if exposed.
PRIVATE_KEY=

# --- Storage ---
S3_BUCKET_NAME=
S3_BUCKET_REGION=us-east-1
S3_BUCKET_ACCESS_KEY_ID=
S3_BUCKET_SECRET_ACCESS_KEY=
CLOUDFRONT_URL=https://your-distribution.cloudfront.net/

# --- App ---
PORT=3000
NODE_ENV=development
# Also used as the base URL for links in emails.
FRONTEND_URL=http://localhost:5174

    "@prisma/client": "^5.19.1",
    "@solana/web3.js": "^1.91.8",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/passport": "^1.0.17",
    "@types/passport-google-oauth20": "^2.0.17",
    "@types/passport-local": "^1.0.38",
    "@types/qrcode": "^1.5.6",
    "argon2": "^0.45.1",
    "bs58": "^5.0.0",
    "cors": "^2.8.5",
